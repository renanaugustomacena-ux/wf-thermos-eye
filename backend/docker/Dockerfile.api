# WF-Thermos-Eye Backend API
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy API code
COPY api/ ./api/

# Expose port
EXPOSE 8443

# Run the API
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8443"]
