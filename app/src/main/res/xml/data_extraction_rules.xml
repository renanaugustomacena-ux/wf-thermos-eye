<?xml version="1.0" encoding="utf-8"?>
<!--
  Survey + measurement data is collected on-device for personal use. Do not
  back it up to the cloud or transfer it to other devices. allowBackup is
  already false in the manifest; this file completes the policy for Android
  12+ which now uses these rules independently of allowBackup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
